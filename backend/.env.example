# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Groq model name
GROQ_MODEL=openai/gpt-oss-120b

# Environment: "development" or "production"
ENVIRONMENT=development

# Allowed frontend origins (comma-separated, e.g. https://your-app.vercel.app)
FRONTEND_ORIGINS=

# Session cookie name
SESSION_COOKIE_NAME=alc_session

# Session data retention in hours
SESSION_TTL_HOURS=24

# Rate limits per minute (default endpoints / LLM endpoints)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_LLM=10/minute

# Directory for session JSON files
DATA_DIR=data

# Logging verbosity level
LOG_LEVEL=INFO
