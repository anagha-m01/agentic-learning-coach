# Get a free API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Any currently-supported Groq model. See https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# Comma-separated list of extra frontend origins allowed to call this API
# (localhost:5173/5174 are always allowed). Only needed once you deploy.
# Example: FRONTEND_ORIGINS=https://your-app.vercel.app
FRONTEND_ORIGINS=